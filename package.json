{
  "name": "geolocation-component",
  "version": "2.0.1",
  "homepage": "./",
  "repository": "https://github.com/pandasuite/geolocation-component.git",
  "author": "Benjamin Barbe <benjamin@pandasuite.com>",
  "license": "MIT",
  "scripts": {
    "start": "PORT=9000 serve",
    "build": "rm -f pandasuite-component.zip geolocation-component-v*.zip && zip -r -X \"geolocation-component-v$npm_package_version.zip\" * -x /node_modules/* package.json yarn.lock *.DS_Store* crossdomain.xml \"*.zip\"",
    "release": "release-it --no-npm.publish"
  },
  "release-it": {
    "hooks": {
      "after:bump": "yarn build"
    },
    "github": {
      "release": true,
      "assets": [
        "geolocation-component-v*.zip"
      ]
    }
  },
  "devDependencies": {
    "release-it": "^13.6.1",
    "serve": "^11.3.1"
  }
}
